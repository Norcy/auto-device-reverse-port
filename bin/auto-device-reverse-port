#!/bin/zsh

set -e

LABEL="com.norcy.auto-device-reverse-port"
OLD_LABEL="com.norcy.hdc-rport-keeper"
LEGACY_LABEL="com.norcy.device-reverse-port"
SOURCE_SCRIPT="${0:A}"
INSTALL_DIR="$HOME/.local/share/auto-device-reverse-port"
INSTALL_SCRIPT="$INSTALL_DIR/auto-device-reverse-port.sh"
PLIST_PATH="$HOME/Library/LaunchAgents/$LABEL.plist"
OLD_PLIST_PATH="$HOME/Library/LaunchAgents/$OLD_LABEL.plist"
LEGACY_PLIST_PATH="$HOME/Library/LaunchAgents/$LEGACY_LABEL.plist"
LOG_DIR="$HOME/Library/Logs/auto-device-reverse-port"
STATE_DIR="$HOME/Library/Application Support/auto-device-reverse-port"
LEGACY_INSTALL_DIR="$HOME/.local/share/device-reverse-port"
LEGACY_STATE_DIR="$HOME/Library/Application Support/device-reverse-port"
LEGACY_LOG_DIR="$HOME/Library/Logs/device-reverse-port"
OLD_INSTALL_DIR="$HOME/.local/share/hdc-rport-keeper"
OLD_STATE_DIR="$HOME/Library/Application Support/hdc-rport-keeper"
OLD_LOG_DIR="$HOME/Library/Logs/hdc-rport-keeper"
# Explicit legacy settings retain their original single-mapping behavior.
if [[ -n "${DEVICE_REVERSE_PORTS:-}" ]]; then
  PORT_SPEC="$DEVICE_REVERSE_PORTS"
elif [[ -n "${DEVICE_REVERSE_LOCAL_PORT:-}" || -n "${DEVICE_REVERSE_REMOTE_PORT:-}" ]]; then
  PORT_SPEC="${DEVICE_REVERSE_LOCAL_PORT:-8081}:${DEVICE_REVERSE_REMOTE_PORT:-8081}"
else
  PORT_SPEC="8081,8082"
fi

# Each entry is device-port[:computer-port]. Normalize before writing the plist.
if [[ "$PORT_SPEC" == ,* || "$PORT_SPEC" == *, || "$PORT_SPEC" == *,,* ]]; then
  echo "端口列表不能包含空项: $PORT_SPEC" >&2
  exit 1
fi
typeset -a PORT_MAPPINGS
for entry in ${(s:,:)PORT_SPEC}; do
  if [[ "$entry" != <-> && "$entry" != <->:<-> ]]; then
    echo "无效端口配置: $entry（示例: 8081,8082 或 8082:8081）" >&2
    exit 1
  fi
  device_port="${entry%%:*}"
  computer_port="${entry##*:}"
  if (( ${#device_port} > 5 || ${#computer_port} > 5 )); then
    echo "端口必须在 1–65535 之间: $entry" >&2
    exit 1
  fi
  device_port=$((10#$device_port))
  computer_port=$((10#$computer_port))
  if (( device_port < 1 || device_port > 65535 || computer_port < 1 || computer_port > 65535 )); then
    echo "端口必须在 1–65535 之间: $entry" >&2
    exit 1
  fi
  PORT_MAPPINGS+=("$device_port:$computer_port")
done
PORT_SPEC="${(j:,:)PORT_MAPPINGS}"
INTERVAL="${DEVICE_REVERSE_INTERVAL:-5}"
HDC_PATH="${HDC_PATH:-}"
ADB_PATH="${ADB_PATH:-}"
ADB_DISCOVERY_RETRIES="${DEVICE_REVERSE_ADB_DISCOVERY_RETRIES:-3}"
ADB_DISCOVERY_DELAY="${DEVICE_REVERSE_ADB_DISCOVERY_DELAY:-1}"

find_hdc() {
  if [ -n "$HDC_PATH" ] && [ -x "$HDC_PATH" ]; then
    echo "$HDC_PATH"
    return
  fi

  if command -v hdc >/dev/null 2>&1; then
    command -v hdc
    return
  fi

  local default_hdc="/Applications/DevEco-Studio.app/Contents/sdk/default/openharmony/toolchains/hdc"
  if [ -x "$default_hdc" ]; then
    echo "$default_hdc"
    return
  fi

  echo ""
}

find_adb() {
  if [ -n "$ADB_PATH" ] && [ -x "$ADB_PATH" ]; then
    echo "$ADB_PATH"
    return
  fi

  if command -v adb >/dev/null 2>&1; then
    command -v adb
    return
  fi

  local default_adb="$HOME/Library/Android/sdk/platform-tools/adb"
  if [ -x "$default_adb" ]; then
    echo "$default_adb"
    return
  fi

  echo ""
}

run_hdc() {
  local hdc
  hdc="$(find_hdc)"
  if [ -z "$hdc" ]; then
    echo ""
    return
  fi

  local targets
  targets="$("$hdc" list targets 2>/dev/null | awk 'NF && $0 !~ /Empty|^\[|^List/ {print $1}')"
  if [ -z "$targets" ]; then
    echo ""
    return
  fi

  local target mapping
  for target in ${(f)targets}; do
    for mapping in "${PORT_MAPPINGS[@]}"; do
      if ! "$hdc" -t "$target" rport "tcp:${mapping%%:*}" "tcp:${mapping##*:}"; then
        echo "hdc rport failed for $target ($mapping)" >&2
      fi
    done
  done

  printf "hdc:%s\n" "$targets"
}

run_adb() {
  local adb
  adb="$(find_adb)"
  if [ -z "$adb" ]; then
    echo ""
    return
  fi

  # The first `adb devices` may only start the adb server. In particular, a
  # freshly attached USB device can still be transitioning through offline
  # before it becomes usable. A status command used to hide this race by
  # performing another adb query from the terminal.
  "$adb" start-server >/dev/null 2>&1 || true

  local targets attempt=1
  while true; do
    targets="$("$adb" devices 2>/dev/null | awk '$2 == "device" {print $1}')"
    if [ -n "$targets" ] || [ "$attempt" -ge "$ADB_DISCOVERY_RETRIES" ]; then
      break
    fi

    sleep "$ADB_DISCOVERY_DELAY"
    attempt=$((attempt + 1))
  done

  if [ -z "$targets" ]; then
    echo ""
    return
  fi

  local target mapping
  for target in ${(f)targets}; do
    for mapping in "${PORT_MAPPINGS[@]}"; do
      if ! "$adb" -s "$target" reverse "tcp:${mapping%%:*}" "tcp:${mapping##*:}" >/dev/null; then
        echo "adb reverse failed for $target ($mapping)" >&2
      fi
    done
  done

  printf "adb:%s\n" "$targets"
}

run_once() {
  # Reapply every interval: a reconnect can discard mappings without changing IDs.
  run_hdc >/dev/null
  run_adb >/dev/null
}

write_plist() {
  mkdir -p "$HOME/Library/LaunchAgents" "$LOG_DIR"

  cat > "$PLIST_PATH" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>$LABEL</string>

    <key>ProgramArguments</key>
    <array>
      <string>$INSTALL_SCRIPT</string>
      <string>run-once</string>
    </array>

    <key>StartInterval</key>
    <integer>$INTERVAL</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
      <key>DEVICE_REVERSE_PORTS</key>
      <string>$PORT_SPEC</string>
      <key>DEVICE_REVERSE_ADB_DISCOVERY_RETRIES</key>
      <string>$ADB_DISCOVERY_RETRIES</string>
      <key>DEVICE_REVERSE_ADB_DISCOVERY_DELAY</key>
      <string>$ADB_DISCOVERY_DELAY</string>
    </dict>

    <key>StandardOutPath</key>
    <string>$LOG_DIR/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>$LOG_DIR/stderr.log</string>
  </dict>
</plist>
EOF
}

install_service() {
  mkdir -p "$INSTALL_DIR"
  cp "$SOURCE_SCRIPT" "$INSTALL_SCRIPT"
  chmod +x "$INSTALL_SCRIPT"
  write_plist

  launchctl unload "$OLD_PLIST_PATH" >/dev/null 2>&1 || true
  launchctl unload "$LEGACY_PLIST_PATH" >/dev/null 2>&1 || true
  rm -f "$OLD_PLIST_PATH" "$LEGACY_PLIST_PATH"
  rm -rf "$OLD_INSTALL_DIR" "$OLD_STATE_DIR" "$OLD_LOG_DIR"
  rm -rf "$LEGACY_INSTALL_DIR" "$LEGACY_STATE_DIR" "$LEGACY_LOG_DIR"

  launchctl unload "$PLIST_PATH" >/dev/null 2>&1 || true
  launchctl load "$PLIST_PATH"

  echo "已安装 $LABEL"
  echo "端口（设备:电脑）: $PORT_SPEC"
}

uninstall_service() {
  launchctl unload "$PLIST_PATH" >/dev/null 2>&1 || true
  launchctl unload "$LEGACY_PLIST_PATH" >/dev/null 2>&1 || true
  launchctl unload "$OLD_PLIST_PATH" >/dev/null 2>&1 || true
  rm -f "$PLIST_PATH" "$LEGACY_PLIST_PATH" "$OLD_PLIST_PATH"
  rm -rf "$INSTALL_DIR" "$STATE_DIR" "$LOG_DIR"
  rm -rf "$LEGACY_INSTALL_DIR" "$LEGACY_STATE_DIR" "$LEGACY_LOG_DIR"
  rm -rf "$OLD_INSTALL_DIR" "$OLD_STATE_DIR" "$OLD_LOG_DIR"
  echo "已卸载 $LABEL"
}

service_status() {
  echo "服务:"
  launchctl print "gui/$(id -u)/$LABEL" 2>/dev/null | awk '
    /state =|runs =|last exit code =|run interval =/ {
      sub(/^[[:space:]]+/, "")
      print "  " $0
    }
  ' || echo "  未加载"
  echo "配置: $PLIST_PATH"
  echo "日志: $LOG_DIR"

  local hdc adb
  hdc="$(find_hdc)"
  adb="$(find_adb)"

  echo ""
  echo "Harmony:"
  if [ -z "$hdc" ]; then
    echo "  hdc: 未找到"
  else
    echo "  hdc: $hdc"
    echo "  设备:"
    "$hdc" list targets 2>/dev/null | sed 's/^/    /' || true
    echo "  映射:"
    "$hdc" fport ls 2>/dev/null | sed 's/^/    /' || true
  fi

  echo ""
  echo "Android:"
  if [ -z "$adb" ]; then
    echo "  adb: 未找到"
  else
    echo "  adb: $adb"
    echo "  设备:"
    "$adb" devices 2>/dev/null | sed 's/^/    /' || true
    echo "  映射:"
    local target targets
    targets="$("$adb" devices 2>/dev/null | awk '$2 == "device" {print $1}')"
    for target in ${(f)targets}; do
      echo "    $target:"
      "$adb" -s "$target" reverse --list 2>/dev/null | sed 's/^/      /' || true
    done
  fi
}

case "$1" in
  install)
    install_service
    ;;
  uninstall)
    uninstall_service
    ;;
  start)
    launchctl load "$PLIST_PATH"
    ;;
  stop)
    launchctl unload "$PLIST_PATH"
    ;;
  restart)
    launchctl unload "$PLIST_PATH" >/dev/null 2>&1 || true
    launchctl load "$PLIST_PATH"
    ;;
  status)
    service_status
    ;;
  run-once)
    run_once
    ;;
  *)
    echo "用法:"
    echo "  auto-device-reverse-port install"
    echo "  auto-device-reverse-port status"
    echo "  auto-device-reverse-port uninstall"
    echo "  auto-device-reverse-port run-once"
    echo ""
    echo "可选环境变量:"
    echo "  HDC_PATH=/path/to/hdc"
    echo "  ADB_PATH=/path/to/adb"
    echo "  DEVICE_REVERSE_PORTS=8081,8082（或 8082:8081）"
    echo "  DEVICE_REVERSE_LOCAL_PORT=8081（兼容旧配置）"
    echo "  DEVICE_REVERSE_REMOTE_PORT=8081"
    echo "  DEVICE_REVERSE_INTERVAL=5"
    echo "  DEVICE_REVERSE_ADB_DISCOVERY_RETRIES=3"
    echo "  DEVICE_REVERSE_ADB_DISCOVERY_DELAY=1"
    ;;
esac
